# ----------------------------------------------------------------------------
# final-checker config. Copy to .env and override as needed. Prefix: FC_
# Nested provider knobs use a double-underscore delimiter, e.g. FC_GEMINI__PRO_MODEL
# ----------------------------------------------------------------------------

# Global
# FC_DEFAULT_CONCURRENCY=5
# FC_MAX_CONCURRENCY=100
# FC_MAX_KEYS_PER_JOB=500
# FC_JOB_TTL_SECONDS=3600

# Gemini
# FC_GEMINI__PRO_MODEL=gemini-3.1-pro
# FC_GEMINI__IMAGE_MODEL=gemini-3.1-flash-image
# FC_GEMINI__BURST_RPS=50
# FC_GEMINI__BURST_SECONDS=30
# FC_GEMINI__T1_CUT_S=15
# FC_GEMINI__T2_CUT_S=30

# OpenAI
# FC_OPENAI__PROBE_MODEL=gpt-4o-mini
# FC_OPENAI__IMAGE_MODEL=gpt-image-2
# FC_OPENAI__IMAGE_BURST_RPS=30
# FC_OPENAI__IMAGE_BURST_CAP=40

# Anthropic
# FC_ANTHROPIC__PROBE_MODEL=claude-haiku-4-5
# FC_ANTHROPIC__ANTHROPIC_VERSION=2023-06-01
# FC_ANTHROPIC__MAX_MODELS_TO_PROBE=30
